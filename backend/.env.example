# Core server
NODE_ENV=development
PORT=3001

# API security
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=ricks-dj
JWT_AUDIENCE=ricks-dj-api
JWT_EXPIRES_IN=2h

# Gateway/origin controls
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=20
INTEGRATION_RATE_LIMIT_PER_MINUTE=20

# Body limits
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Integrations
RAPIDAPI_KEY=replace-with-rapidapi-key
SHAZAM_RECOGNIZE_PATH=tracks/recognize

# AI agent
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
