{
  "name": "soundit-dj-desktop",
  "version": "1.0.0",
  "description": "Sound It DJ Desktop Application",
  "author": "Sound It DJ <admin@sounditmuzik.com>",
  "main": "main.js",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.sounditdj.app",
    "productName": "Sound It DJ",
    "copyright": "Copyright © 2026 Sound It DJ",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**/*",
      "frontend-dist/**/*",
      "backend/package.json",
      {
        "from": "../backend/src",
        "to": "backend/src",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "bplist-parser": "^0.3.2",
    "electron-is-dev": "^2.0.0",
    "fast-xml-parser": "^5.8.0",
    "fs-extra": "^11.2.0",
    "music-metadata": "^7.14.0",
    "plist": "^3.1.0",
    "uuid": "^9.0.1"
  }
}
